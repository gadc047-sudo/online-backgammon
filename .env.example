# Copy to .env for local overrides. .env is git-ignored.

# Port the HTTP + WebSocket server listens on. Defaults to 3001 when unset.
# In production the host (Railway) injects PORT into the environment. The server
# must read it from there and bind to it - never hard-code a port in deployed code.
PORT=3001

# TypeSafe System One API key, for the "Jev vs Computer" spectator lane.
# Server-side only - it is read in src/server/typesafe/client.ts, sent on one
# Authorization header, and never reaches the browser. Without it the lane's
# CTA fails with a clear message instead of opening a table that cannot decide
# anything; the other two lanes are unaffected. Never commit a real key.
TYPESAFE_API_KEY=
